<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirBnb</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
      integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      rel="shortcut icon"
      sizes="76x76"
      type="image/png"
      href="https://a0.muscache.com/im/pictures/AirbnbPlatformAssets/AirbnbPlatformAssets-Favicons/original/d1fcc0b3-865f-485a-b28b-43ca0bf7c891.png?im_w=240"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>

  <body class="">
    <div class="d-flex justify-content-center align-items-center" >
      <%- include("../inc/flash.ejs") %>
    </div>
    <div class="show-listing-page signup-card d-flex flex-column">
      <div
        class="new-listing-card signup-card-form mt-5"
        style="max-width: 350px"
      >
        <h2 style="color: #fff; font-weight: bold">Signup</h2>
        <form
          action="/signup"
          method="post"
          novalidate
          class="needs-validation"
        >
          <div class="form-group">
            <label for="title">email</label>
            <input
              type="email"
              name="user[email]"
              id="email"
              placeholder="email"
              required
            />
          </div>
          <div class="form-group">
            <label for="username">username</label>
            <input
              type="text"
              name="user[username]"
              id="username"
              placeholder="username"
              required
            />
          </div>
          <div class="form-group">
            <label for="password">password</label>
            <input
              type="password"
              name="user[password]"
              id="password"
              placeholder="password"
              required
            />
          </div>
          <div class="show-btns">
            <button class="btn w-100">SignUp</button>
          </div>
        </form>
      </div>
    </div>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js"
      integrity="sha512-oJ8QbaQThQoJZ7oEv+29jfPM6CcP+zUxh3PKJs1vyOhx0UraUrE7PQgeItu3dOuCJyrzWpoYMsVjkkPEBzbUqw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/scripts/script.js"></script>
  </body>
</html>
