<% layout("/layouts/boilerplate") %>
<div class="cont">
  <div class="image">
    <img src="https://images.unsplash.com/photo-1788399536592-11b497494e33?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MzZ8fGlzbGFuZCUyMHN1bnNldHxlbnwwfHwwfHx8Mg%3D%3D" alt="" style="width: 100%; height: 94vh; object-fit: cover;" />
    <div class="image-ovelay">


      <h1 class="outline-text">find your next stay</h1>

      <h4>Discover unique places to stay around the world</h4>

    </div>
  </div>

</div>
<div class="main">

  <h3 class="list-heading">all listings</h3>

  <div class="listings d-flex flex-wrap gap-3">

    <% for(d of data){ %>
    <a href="listing/<%= d.id %>/show">
      <div class="place-card">

        <div class="card-image">
          <img src="<%= d.image %>" alt="<%= d.title %>">
        </div>

        <div class="c-title">
          <%= d.title %>
        </div>

        <div class="c-country">
          <i class="fa-solid fa-location-dot" style="color: rgb(133, 134, 134);"></i>
          <%= d.location %>, <%= d.country %>
        </div>

        <div class="c-price">
          <%= d.price.toLocaleString("en-IN") %>/night
        </div>

      </div>
    </a>
    <% } %>
    <a href="/listing/new">
      <div class="add-card">
        <p>add list</p>
      </div>
    </a>
  </div>

</div>